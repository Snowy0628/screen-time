<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 本地构建配置：显式声明包源，避免依赖可能被限制访问的用户级配置 -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
