bin/
obj/
*.user
*.suo
.vs/

# ---- 发布产物与安装包（体积大，且可由源码重新生成）----
dist/
package/
installer/bin/
installer/obj/

# ---- 本地 NuGet 缓存与工具目录 ----
.nugetpackages/
.dotnethome/
.appdata/
.restoretest/
.tools/

# ---- 本地测试数据与临时目录 ----
.selftest/
