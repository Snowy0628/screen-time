.iconprobe/
.packtest/
.wpftest/
.it3/
.it4/
.it5/
*.db
*.db-wal
*.db-shm
*.log

# ---- 运行期产生的文件 ----
crash.log
takeover.request
tray-status.txt
settings.json
screentime-boot.log

# ---- 操作系统 ----
Thumbs.db
desktop.ini
