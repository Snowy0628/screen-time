<!--
  浅色主题。配色令牌与 design/ui-prototype.html 里的 CSS 变量一一对应，
  改一处两边都应同步（原型是设计基准）。

  WPF 的 DynamicResource 允许运行时整体替换这套 key，因此深浅色切换
  只需换掉合并进来的字典，不需要重启。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 基础表面 -->
    <SolidColorBrush x:Key="BgBrush"           Color="#F4F5F7"/>
    <SolidColorBrush x:Key="SurfaceBrush"      Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush"     Color="#FAFBFC"/>
    <SolidColorBrush x:Key="Surface3Brush"     Color="#F0F1F4"/>
    <SolidColorBrush x:Key="BorderBrush"       Color="#E4E6EA"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D3D6DC"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextBrush"  Color="#1B1D21"/>
    <SolidColorBrush x:Key="Text2Brush" Color="#5B6069"/>
    <SolidColorBrush x:Key="Text3Brush" Color="#8B9099"/>

    <!-- 强调色与涨跌语义（用时长变多是坏消息，所以涨=红、跌=绿） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="UpBrush"     Color="#D9534F"/>
    <SolidColorBrush x:Key="DownBrush"   Color="#2E9E6B"/>

    <!-- 状态色：前台使用 / 空闲 / 锁屏 / 熄屏睡眠 -->
    <SolidColorBrush x:Key="StateActiveBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="StateIdleBrush"   Color="#C3C8D1"/>
    <SolidColorBrush x:Key="StateLockedBrush" Color="#8B93A3"/>
    <SolidColorBrush x:Key="StateOffBrush"    Color="#D7DAE0"/>

    <!-- 主卡片渐变（原型里的 hero 卡片） -->
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="HeroTextBrush"     Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeroTextDimBrush"  Color="#D8E2FF"/>
    <SolidColorBrush x:Key="HeroBadgeBrush"    Color="#33FFFFFF"/>

</ResourceDictionary>
