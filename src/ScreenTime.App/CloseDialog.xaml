<Window x:Class="ScreenTime.App.CloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="屏幕使用时间"
        SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        x:ClassModifier="internal"
        Background="{DynamicResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True">

    <Border Padding="24,20,24,18" Background="{DynamicResource SurfaceBrush}">
        <StackPanel>

            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource HeroBrush}"
                        VerticalAlignment="Top">
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="要关闭窗口还是退出程序？" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="SubText" FontSize="11.5" Margin="0,3,0,0"
                               Foreground="{DynamicResource Text3Brush}"/>
                </StackPanel>
            </StackPanel>

            <Border CornerRadius="8" Padding="12,10" Margin="0,16,0,0"
                    Background="{DynamicResource Surface3Brush}">
                <TextBlock FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text2Brush}"
                           Text="最小化到托盘后程序继续在后台记录使用时长，可从任务栏右下角的托盘图标重新打开本界面。"/>
            </Border>

            <CheckBox x:Name="RememberCheck" Content="记住我的选择，以后不再询问"
                      Margin="0,16,0,0" FontSize="12"
                      Foreground="{DynamicResource Text2Brush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="取消" Style="{StaticResource DialogButton}"
                        Margin="0,0,8,0" Click="OnCancel"/>
                <Button x:Name="ExitButton" Content="彻底退出" Style="{StaticResource DialogButton}"
                        Margin="0,0,8,0" Click="OnExit"/>
                <Button x:Name="TrayButton" Content="最小化到托盘" Style="{StaticResource DialogButton}"
                        IsDefault="True" Click="OnTray"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
