<Window x:Class="ScreenTime.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ScreenTime.App.Controls"
        xmlns:local="clr-namespace:ScreenTime.App"
        Title="屏幕使用时间"
        Width="1060" Height="780" MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Microsoft YaHei UI, Microsoft YaHei, Segoe UI"
        FontSize="13">

    <Window.Resources>

        <!-- ===== 卡片 ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 扁平图标按钮 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 日 / 周 / 月 分段按钮 ===== -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="14,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通文字按钮 -->
        <Style x:Key="TextButton" TargetType="Button">            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2Brush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Surface3Brush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== KPI 数字单位 ===== -->
        <Style x:Key="KpiUnit" TargetType="Run">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Text3Brush}"/>
        </Style>

        <!-- ===== 时间轴色块 ===== -->
        <DataTemplate x:Key="SegmentTemplate">
            <Border Background="{Binding Fill}" ToolTip="{Binding Tooltip}" Margin="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </DataTemplate>

        <!--
            ===== 分时柱状图：一根柱子 =====
            悬停效果对齐 HTML 原型：
              · 整柱提亮（原型 `.barwrap:hover .barbody{filter:brightness(1.1)}`）
              · 色块之间加半透明白分隔线（原型 `.slice::after`）
              · 提示框淡入（原型 #tip 的 opacity 过渡）

            柱顶原本要画该小时的 Top3 应用图标，但那一行在实测中始终不渲染
            （ViewModel 侧图标数据正常、图标本身也能取到，问题出在模板层且定位成本过高）。
            已改为把高度让给柱身，Top3 信息放在悬停提示里 —— 信息不丢，图形更饱满。
        -->
        <DataTemplate x:Key="HourBarTemplate">
            <Grid Margin="1.5,0" Background="Transparent" Cursor="Hand"
                  MouseEnter="OnHourBarEnter" MouseLeave="OnHourBarLeave"
                  ToolTipOpening="OnBarTooltipOpening">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>      <!-- 柱身（底部对齐） -->
                    <RowDefinition Height="Auto"/>   <!-- 小时标签 -->
                </Grid.RowDefinitions>

                <!-- 柱身 -->
                <Grid Grid.Row="0" VerticalAlignment="Bottom">
                    <Border x:Name="BarBody" Height="{Binding BarHeight}"
                            CornerRadius="4,4,2,2" ClipToBounds="True"
                            Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.Background>
                                <SolidColorBrush Color="{DynamicResource Surface3Color}"/>
                            </Grid.Background>

                            <!-- 色块：堆叠显示各应用占比，块间有半透明白分隔线 -->
                            <ItemsControl ItemsSource="{Binding Slices}" ToolTip="{x:Null}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Grid/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Fill}"
                                                BorderBrush="#66FFFFFF" BorderThickness="0,0,0,1"
                                                ToolTip="{x:Null}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 悬停提亮层：透明度由动画驱动，不影响色块本身的颜色 -->
                            <Border x:Name="HoverVeil" Background="White" Opacity="0"
                                    IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding HourLabel}" FontSize="10"
                           Foreground="{DynamicResource Text3Brush}"
                           HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </Grid>
        </DataTemplate>

        <!-- ===== 排行榜一行 ===== -->
        <DataTemplate x:Key="AppRowTemplate">
            <Grid Margin="0,4,0,2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26"/>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="86"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Rank}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12.5"
                           Foreground="{Binding RankBrush}"/>

                <Border Grid.Row="0" Grid.Column="1" Width="32" Height="32" CornerRadius="7"
                        Background="{DynamicResource Surface3Brush}"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Image Source="{Binding Icon}" Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="{Binding Category}" FontSize="10.5"
                               Foreground="{DynamicResource Text3Brush}" Margin="0,1,0,0"/>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding DurationText}" FontSize="13"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextBrush}"/>

                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding ShareText}" FontSize="11.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text2Brush}"/>

                <TextBlock Grid.Row="0" Grid.Column="5" Text="{Binding DeltaText}" FontSize="11.5"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{Binding DeltaBrush}"/>

                <!-- 占比条：跨应用名列，视觉上把该应用与第一名做对比 -->
                <ctl:RatioBar Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4"
                              Margin="8,5,0,0" Height="5"
                              Ratio="{Binding BarRatio}" BarBrush="{Binding BarBrush}"/>
            </Grid>
        </DataTemplate>

    </Window.Resources>

    <!--
        x:Name 是必要的：设了背景图之后，卡片半透明是通过往这个 Grid 的
        Resources 里放覆盖值实现的（见 SetCardTranslucency）。
        放在这里而不是 Application.Resources，是为了让**设置面板**不受影响——
        面板在下面另一个分支，资源查找走不进来，于是它保持主题里的不透明底色。
    -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 顶栏 -->
            <RowDefinition Height="*"/>     <!-- 内容 -->
        </Grid.RowDefinitions>

        <!--
            背景图层。必须在所有内容之下，所以放在 RowDefinitions 之后、
            顶栏之前，并在下面那层内容上用 Panel.ZIndex 抬高。

            三层结构：
              1. Image      背景图（用户选的照片）
              2. Rectangle  半透明遮罩——保证内容可读。
                            浅色主题用白遮罩、深色主题用黑遮罩，
                            由 ApplyBackgroundImage() 按当前主题设置。
              3. 内容       现有界面

            图片用 UniformToFill 铺满并裁切，不做平铺（平铺会显得很碎）。
            另外会把原图预缩放到窗口尺寸再显示，避免每帧缩放 4K 大图。
        -->
        <Image x:Name="BgImage" Grid.RowSpan="2"
               Stretch="UniformToFill" Opacity="0"
               IsHitTestVisible="False" Panel.ZIndex="0"/>

        <Rectangle x:Name="BgVeil" Grid.RowSpan="2"
                   Fill="#FFFFFF" Opacity="0"
                   IsHitTestVisible="False" Panel.ZIndex="1"/>

        <!-- ===== 顶栏 ===== -->
        <Grid Grid.Row="0" Margin="22,18,22,10" Panel.ZIndex="2">
            <StackPanel Orientation="Horizontal">
                <!--
                    用程序图标本身当 Logo（见 csproj 里的 Resource 项），
                    不再用字体符号——这样和任务栏、桌面快捷方式长得一模一样。
                    图标固定是默认品牌色（蓝紫渐变）；界面里的强调色跟用户
                    选的主题色走，两者分工明确。
                -->
                <Image x:Name="BrandIcon" Width="30" Height="30"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="屏幕使用时间" FontSize="15.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="SubTitleText" FontSize="11.5"
                               Foreground="{DynamicResource Text3Brush}"/>
                </StackPanel>
            </StackPanel>

            <!-- 右侧：实时状态 + 范围切换 + 主题切换 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!--
                    状态胶囊的圆角改成 10，与右侧的「日/周/月」分段控件一致。
                    原来是 999（全圆胶囊），两个控件并排时形状语言不统一：
                    一个圆头一个方角，看着像两套设计拼在一起。
                -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="11,5" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{DynamicResource DownBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="LiveText" Margin="7,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 日 / 周 / 月 范围切换 -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabDay" Style="{StaticResource SegmentButton}" IsChecked="True"
                                     Content="日" Tag="Day" Checked="OnRangeChecked"/>
                        <RadioButton x:Name="TabWeek" Style="{StaticResource SegmentButton}"
                                     Content="周" Tag="Week" Checked="OnRangeChecked"/>
                        <RadioButton x:Name="TabMonth" Style="{StaticResource SegmentButton}"
                                     Content="月" Tag="Month" Checked="OnRangeChecked"/>
                    </StackPanel>
                </Border>

                <!--
                    按钮顺序（用户指定）：日/周/月 → 分类统计 → 深浅色 → 设置。
                    分类统计夹在范围切换和深浅色中间。
                    全部用 Segoe MDL2 的单色字形，天然是黑白的，
                    与界面主题一起走（不像位图图标还要准备两套）。
                -->
                <Button x:Name="CategoryButton" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                        Click="OnCategoryClick" ToolTip="应用分类与占比统计">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>

                <Button x:Name="ThemeButton" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                        Click="OnThemeClick" ToolTip="切换外观：跟随系统 / 浅色 / 深色">
                    <TextBlock x:Name="ThemeGlyph" Text="&#xE793;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>

                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                        Click="OnSettingsClick" ToolTip="设置">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 内容 ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,22"
                      Panel.ZIndex="2" Background="Transparent">
            <StackPanel>

                <!--
                    三块内容区互斥显示（单日 / 周 / 月）。
                    用 Visibility 切换而不是重建整个视觉树：切回来时滚动位置与状态都还在。
                -->
                <StackPanel x:Name="SectionDay">

                <!-- ===== 日期导航 ===== -->
                <Grid Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="PrevDayButton" Style="{StaticResource IconButton}" Click="OnPrevDay">
                            <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Border Background="{DynamicResource Surface3Brush}" CornerRadius="8"
                                Padding="12,5" Margin="8,0" MinWidth="160">
                            <TextBlock x:Name="DateLabel" Text="—" FontSize="13" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </Border>
                        <Button x:Name="NextDayButton" Style="{StaticResource IconButton}" Click="OnNextDay">
                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Button Style="{StaticResource TextButton}" Content="今天" Click="OnToday" Margin="6,0,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="DayHintText" Style="{StaticResource Hint}"
                               HorizontalAlignment="Right"/>
                </Grid>

                <!-- ===== 概览四卡 ===== -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 主卡：屏幕前总时长（渐变） -->
                    <Border Grid.Column="0" CornerRadius="14" Padding="18,16" Margin="0,0,12,0"
                            Background="{DynamicResource HeroBrush}">
                        <StackPanel>
                            <TextBlock Text="屏幕前总时长" FontSize="11.5"
                                       Foreground="{DynamicResource HeroTextDimBrush}"/>
                            <TextBlock x:Name="KpiTotal" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource HeroTextBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border x:Name="DeltaBadge" CornerRadius="6" Padding="7,2"
                                        Background="{DynamicResource HeroBadgeBrush}">
                                    <TextBlock x:Name="DeltaText" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                                <TextBlock Text="较昨天" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource HeroTextDimBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 真正在使用 -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="真正在使用" FontSize="11.5"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBlock x:Name="KpiActive" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="KpiActiveShare" FontSize="11.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource Text3Brush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 熄屏 / 锁屏 / 睡眠 -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="熄屏 / 锁屏 / 睡眠" FontSize="11.5"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBlock x:Name="KpiOff" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"
                                       TextWrapping="NoWrap"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="不计入屏幕使用" FontSize="11.5" Margin="0,8,0,0"
                                       Foreground="{DynamicResource Text3Brush}"/>
                        </StackPanel>
                    </Border>

                    <!-- 最常使用 -->
                    <Border Grid.Column="3" Style="{StaticResource Card}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="最常使用" FontSize="11.5"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBlock x:Name="KpiTop" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="KpiTopFoot" FontSize="11.5" Margin="0,8,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Text3Brush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ===== 全天时间轴 ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="全天时间轴" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Right"
                                       Text="按真实状态着色 · 悬停查看分段"/>
                        </Grid>

                        <!-- 小时刻度 -->
                        <Grid x:Name="TimelineScale" Height="14" Margin="0,0,0,4"/>

                        <!--
                            色块条：列宽按持续时长比例分配，**始终铺满完整一天**。
                            没有记录的时段用浅灰填充（不是留空），
                            悬停会提亮并显示该段的起止时间与状态。
                        -->
                        <Border CornerRadius="8" ClipToBounds="True" Height="38"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Background="{DynamicResource Surface3Brush}"
                                Focusable="False" FocusVisualStyle="{x:Null}">
                            <Grid Focusable="False" FocusVisualStyle="{x:Null}">
                                <Grid x:Name="TimelineGrid" Focusable="False" FocusVisualStyle="{x:Null}"/>
                                <!-- 整点分隔线：叠在色块之上，给出时间参照 -->
                                <Grid x:Name="TimelineGridLines" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- 图例 -->
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="10" Height="10" CornerRadius="3" VerticalAlignment="Center"
                                        Background="{DynamicResource StateActiveBrush}"/>
                                <TextBlock Text="前台使用" FontSize="11.5" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Text2Brush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="10" Height="10" CornerRadius="3" VerticalAlignment="Center"
                                        Background="{DynamicResource StateIdleBrush}"/>
                                <TextBlock Text="空闲" FontSize="11.5" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Text2Brush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                <Border Width="10" Height="10" CornerRadius="3" VerticalAlignment="Center"
                                        Background="{DynamicResource StateLockedBrush}"/>
                                <TextBlock Text="锁屏" FontSize="11.5" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Text2Brush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="10" Height="10" CornerRadius="3" VerticalAlignment="Center"
                                        Background="{DynamicResource StateOffBrush}"/>
                                <TextBlock Text="熄屏 / 睡眠" FontSize="11.5" Margin="6,0,0,0"
                                           Foreground="{DynamicResource Text2Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== 分时应用分布 ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="分时应用分布" Style="{StaticResource CardTitle}"/>
                            <!--
                                副标题只讲"怎么看"，不再堆三条参数说明。
                                原来那句「每根柱 = 1 小时 · 柱高 = 前台使用时长 ·
                                色块按图标主色 · 悬停看 Top3 应用」把刻度、读法、配色、
                                交互全塞在一行，读起来是清单不是句子。现在：
                                  · 轴上的数字已经写明单位是小时，不必再说"每根柱 = 1 小时"
                                  · 柱子高低一眼能看出是时长，不必解释"柱高 = 时长"
                                  · 配色与悬停属于"用过就知道"的东西，放在提示里更合适
                                留一句读法就够了。
                            -->
                            <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Right"
                                       Text="横轴为一天 24 小时，柱高为该小时的时长；悬停查看该时段明细"/>
                        </Grid>

                        <!--
                            柱状图容器。用 Grid 等分宽度给 24 根柱子 + 末端的收尾刻度，
                            柱身由代码构建（每个色块占一行，行高用星号比例表示，
                            WPF 会在固定高度内自动按秒数比例分配像素）。
                            之所以不用 UniformGrid：末尾的 "24:00" 刻度只在 24 列之外
                            多占一点点宽度，UniformGrid 无法表达这种"24 等分 + 尾巴"的布局。

                            HourChartScale 是下层：铺 15/30/45/60 分的时长刻度线 +
                            左侧刻度文字，让柱高可以直接量出来，不必悬停。

                            Focusable=False + FocusVisualStyle={x:Null}：
                            图表本身不可交互（交互在每根柱子上），但容器一旦拿到焦点，
                            WPF 会画一圈虚线焦点框把整个图表圈起来，看着像界面坏了。
                            这里显式关掉——键盘用户也不需要"聚焦到图表"这个能力。
                        -->
                        <Grid Height="176" Margin="0,0,0,4"
                              Focusable="False" FocusVisualStyle="{x:Null}">
                            <Grid x:Name="HourChartScale" IsHitTestVisible="False"/>
                            <Grid x:Name="HourChart" Focusable="False" FocusVisualStyle="{x:Null}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 应用排行 ===== -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="应用使用排行" Style="{StaticResource CardTitle}"/>
                            <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Right"
                                       Text="变化列对比昨天同时长"/>
                        </Grid>

                        <!-- 表头 -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*" MinWidth="120"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="62"/>
                                <ColumnDefinition Width="86"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="2" Text="应用" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBlock Grid.Column="3" Text="时长" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBlock Grid.Column="4" Text="占比" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBlock Grid.Column="5" Text="对比昨天" FontSize="11" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Text3Brush}"/>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,4"/>

                        <ItemsControl x:Name="RankList" ItemsSource="{Binding Ranking}"
                                      ItemTemplate="{StaticResource AppRowTemplate}"/>

                        <TextBlock x:Name="EmptyRankHint" Text="这一天还没有记录到前台应用"
                                   FontSize="12" Margin="0,18,0,10" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource Text3Brush}" Visibility="Collapsed"/>

                        <!-- 归属失败提示：不能让用户对着空排行榜猜原因 -->
                        <Border x:Name="AttributionWarn" CornerRadius="8" Padding="12,9" Margin="0,12,0,0"
                                Background="{DynamicResource Surface3Brush}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Top" Margin="0,1,8,0"
                                           Foreground="{DynamicResource UpBrush}"/>
                                <TextBlock x:Name="AttributionWarnText" FontSize="11.5" TextWrapping="Wrap"
                                           MaxWidth="760" HorizontalAlignment="Left"
                                           Foreground="{DynamicResource Text2Brush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                </StackPanel>
                <!-- ===== 单日视图结束 ===== -->

                <!-- ============ 周视图 ============ -->
                <StackPanel x:Name="SectionWeek" Visibility="Collapsed">

                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Click="OnPrevRange">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            </Button>
                            <Border Background="{DynamicResource Surface3Brush}" CornerRadius="8"
                                    Padding="12,5" Margin="8,0" MinWidth="200">
                                <TextBlock x:Name="WeekRangeLabel" Text="—" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Border>
                            <Button x:Name="NextWeekButton" Style="{StaticResource IconButton}" Click="OnNextRange">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource TextButton}" Content="本周" Click="OnCurrentRange" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="WeekSummary" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="本周每天的使用时长" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Right"
                                           Text="柱高 = 当天屏幕前时长 · 悬停查看构成"/>
                            </Grid>

                            <!-- 与分时柱状图一致：UniformGrid 等分宽度，柱身由代码构建 -->
                            <UniformGrid x:Name="WeekChart" Rows="1" Height="200"/>

                            <Border CornerRadius="6" Padding="9,4" Margin="0,14,0,0"
                                    Background="{DynamicResource Surface3Brush}" HorizontalAlignment="Left">
                                <TextBlock x:Name="WeekCompareText" FontSize="11.5"
                                           Foreground="{DynamicResource Text2Brush}"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="本周应用排行" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="与上周对比" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="应用" FontSize="11" Margin="8,0,0,0"
                                           Foreground="{DynamicResource Text3Brush}"/>
                                <TextBlock Grid.Column="3" Text="时长" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Text3Brush}"/>
                                <TextBlock Grid.Column="4" Text="占比" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Text3Brush}"/>
                                <TextBlock Grid.Column="5" Text="对比上周" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Text3Brush}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="WeekRanking" ItemTemplate="{StaticResource AppRowTemplate}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ 月视图 ============ -->
                <StackPanel x:Name="SectionMonth" Visibility="Collapsed">

                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Click="OnPrevRange">
                                <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            </Button>
                            <Border Background="{DynamicResource Surface3Brush}" CornerRadius="8"
                                    Padding="12,5" Margin="8,0" MinWidth="150">
                                <TextBlock x:Name="MonthRangeLabel" Text="—" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Border>
                            <Button x:Name="NextMonthButton" Style="{StaticResource IconButton}" Click="OnNextRange">
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                            </Button>
                            <Button Style="{StaticResource TextButton}" Content="本月" Click="OnCurrentRange" Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="MonthSummary" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                    </Grid>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="每日使用热力图" Style="{StaticResource CardTitle}"/>
                                <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Right"
                                           Text="颜色越深 = 当天屏幕前时长越长 · 悬停查看"/>
                            </Grid>
                            <ItemsControl x:Name="HeatGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0" HorizontalAlignment="Right">
                                <TextBlock Text="少" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text3Brush}"/>
                                <Border x:Name="HeatLegendMin" Width="14" Height="14" CornerRadius="4" Margin="6,0,3,0"/>
                                <Border x:Name="HeatLegendMid" Width="14" Height="14" CornerRadius="4" Margin="0,0,3,0"/>
                                <Border x:Name="HeatLegendMax" Width="14" Height="14" CornerRadius="4" Margin="0,0,6,0"/>
                                <TextBlock Text="多" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Text3Brush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="本月应用排行" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="与上月对比" Style="{StaticResource Hint}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="2" Text="应用" FontSize="11" Margin="8,0,0,0"
                                           Foreground="{DynamicResource Text3Brush}"/>
                                <TextBlock Grid.Column="3" Text="时长" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Text3Brush}"/>
                                <TextBlock Grid.Column="4" Text="占比" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Text3Brush}"/>
                                <TextBlock Grid.Column="5" Text="对比上月" FontSize="11" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource Text3Brush}"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,4"/>
                            <ItemsControl x:Name="MonthRanking" ItemTemplate="{StaticResource AppRowTemplate}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== 数据说明 ===== -->
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock x:Name="FooterInfo" FontSize="11.5"
                                   Foreground="{DynamicResource Text3Brush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--
            ===== 设置面板 =====
            做成覆盖层而不是独立窗口：不打断主界面的状态，
            也不需要处理"设置窗口"与主窗口的生命周期关系。
        -->
        <!--
            Panel.ZIndex 必须明显高于内容区。
            背景图功能给内容 ScrollViewer 设了 ZIndex=2（为了压在背景图上），
            面板如果还是默认的 0，**主内容就会画到面板上面**——
            表现为图表和文字穿透设置面板，面板看起来像坏了。
            这里给 20，留足余量。
        -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="2" Panel.ZIndex="20"
              Visibility="Collapsed">
            <!-- 半透明遮罩：点击空白处关闭 -->
            <Rectangle Fill="#66000000" MouseLeftButtonDown="OnSettingsBackdropClick"/>

            <Border x:Name="SettingsCard"
                    Width="470" MaxHeight="680"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource DialogSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SettingsSlide" Y="24"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <!--
                        用居中且不偏移的柔和阴影。早期用 ShadowDepth 会配合
                        RenderTransform 在卡片边缘产生一块方形暗斑（渲染伪影），
                        ShadowDepth=0 + 较大 BlurRadius 可以避免。
                    -->
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.16"
                                      Color="#000000" RenderingBias="Quality"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <Grid Grid.Row="0" Margin="22,18,14,12">
                        <StackPanel Orientation="Horizontal">
                            <!--
                                图标与顶栏的「设置」按钮用同一个字形，一看就知道
                                这个面板是从哪儿打开的。之前这里放的是应用图标，
                                和按钮上的齿轮对不上。
                            -->
                            <Border Width="28" Height="28" CornerRadius="8"
                                    Background="{DynamicResource Surface3Brush}">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Border>
                            <TextBlock Text="设置" FontSize="15.5" FontWeight="SemiBold" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                                Click="OnSettingsClose" ToolTip="关闭">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                    </Grid>

                    <!-- 设置项 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,0,22,20">
                        <StackPanel Margin="0,0,0,4">

                            <!-- 记录 -->
                            <TextBlock Text="记录" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,8"
                                       Foreground="{DynamicResource Text2Brush}"/>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="空闲判定阈值" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ComboBox x:Name="IdleCombo" Width="130" SelectionChanged="OnIdleChanged">
                                        <ComboBoxItem Content="30 秒" Tag="30"/>
                                        <ComboBoxItem Content="1 分钟" Tag="60"/>
                                        <ComboBoxItem Content="3 分钟" Tag="180"/>
                                        <ComboBoxItem Content="5 分钟" Tag="300"/>
                                        <ComboBoxItem Content="10 分钟" Tag="600"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="超过这个时长没有键鼠输入，就记为「空闲」"
                                       FontSize="11" Margin="0,-4,0,12"
                                       Foreground="{DynamicResource Text3Brush}"/>

                            <CheckBox x:Name="FullscreenActiveCheck"
                                      Content="真全屏应用算作「正在使用」"
                                      Margin="0,0,0,6" Click="OnFullscreenActiveToggled"
                                      Foreground="{DynamicResource TextBrush}"/>
                            <!--
                                文案必须写明"只认 F11 真全屏"。
                                旧判据把"最大化窗口"也算进来，等于给任何最大化应用开了
                                永久豁免——只要窗口最大化，空闲阈值就永远不生效。
                                而"最大化看视频"那个场景，媒体检测管得更准。
                            -->
                            <TextBlock Text="只认 F11 真全屏（含独占全屏游戏），最大化窗口不算。看视频、上网课不需要靠它——那种情况由「前台是否在放媒体」识别，窗口化播放也算「正在使用」"
                                       FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text3Brush}"/>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="数据写入间隔" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <ComboBox x:Name="FlushCombo" Width="130" HorizontalAlignment="Right"
                                          SelectionChanged="OnFlushChanged">
                                    <ComboBoxItem Content="30 秒" Tag="30"/>
                                    <ComboBoxItem Content="1 分钟" Tag="60"/>
                                    <ComboBoxItem Content="2 分钟" Tag="120"/>
                                    <ComboBoxItem Content="5 分钟" Tag="300"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="间隔越短数据越及时，写入也越频繁"
                                       FontSize="11" Margin="0,-4,0,12"
                                       Foreground="{DynamicResource Text3Brush}"/>

                            <!-- 界面 -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,14"/>
                            <TextBlock Text="外观" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"
                                       Foreground="{DynamicResource Text2Brush}"/>

                            <RadioButton x:Name="ThemeSystemRadio" Content="跟随系统" GroupName="Theme"
                                         Margin="0,0,0,8" Tag="0" Checked="OnThemeModeChanged"
                                         Foreground="{DynamicResource TextBrush}"/>
                            <RadioButton x:Name="ThemeLightRadio" Content="浅色" GroupName="Theme"
                                         Margin="0,0,0,8" Tag="1" Checked="OnThemeModeChanged"
                                         Foreground="{DynamicResource TextBrush}"/>
                            <RadioButton x:Name="ThemeDarkRadio" Content="深色" GroupName="Theme"
                                         Margin="0,0,0,10" Tag="2" Checked="OnThemeModeChanged"
                                         Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="选「跟随系统」时，在 Windows 设置里切换深浅色会立即生效"
                                       FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text3Brush}"/>

                            <!-- ===== 主题色 ===== -->
                            <TextBlock Text="主题色" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="点色块即应用。默认方案是蓝紫渐变；选其它颜色则改为纯色（莫兰迪灰调）"
                                       FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text3Brush}"/>

                            <!--
                                预设色块。按钮由代码生成（见 BuildAccentSwatches），
                                因为每个色块的填充色不同，写死在 XAML 里要复制 7 遍。
                            -->
                            <ItemsControl x:Name="AccentSwatchHost" Margin="0,0,0,10">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="自定义" VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBox x:Name="CustomAccentBox" Grid.Column="1"
                                         Padding="8,5" VerticalContentAlignment="Center"
                                         ToolTip="填十六进制色号，例如 #66CCFF 或 66CCFF"
                                         KeyDown="OnCustomAccentKeyDown"
                                         TextChanged="OnCustomAccentTextChanged"/>
                                <Button x:Name="ApplyAccentBtn" Grid.Column="2" Content="应用"
                                        Style="{StaticResource TextButton}" Margin="6,0,0,0"
                                        Click="OnApplyCustomAccent"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border x:Name="CustomAccentPreview" Width="16" Height="16"
                                        CornerRadius="4" VerticalAlignment="Center"
                                        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"/>
                                <TextBlock x:Name="CustomAccentHint" FontSize="11" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text3Brush}"/>
                            </StackPanel>

                            <!-- ===== 背景图 ===== -->
                            <TextBlock Text="背景图" Margin="0,0,0,8"
                                       Foreground="{DynamicResource TextBrush}"/>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="BgImageName" Grid.Column="0" Text="未设置"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Text2Brush}"/>
                                <Button Grid.Column="1" Content="选择图片"
                                        Style="{StaticResource TextButton}"
                                        Click="OnPickBackgroundImage"/>
                                <Button Grid.Column="2" Content="清除"
                                        Style="{StaticResource TextButton}" Margin="4,0,0,0"
                                        Click="OnClearBackgroundImage"/>
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="不透明度" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="BgOpacityText" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" FontSize="11.5"
                                           Foreground="{DynamicResource Text2Brush}"/>
                            </Grid>
                            <Slider x:Name="BgOpacitySlider" Minimum="0" Maximum="100" Value="25"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    Margin="0,0,0,4"
                                    ValueChanged="OnBgOpacityChanged"/>
                            <TextBlock Text="背景图会降低卡片与文字的可读性，程序会自动提高卡片不透明度作为补偿。建议 20%–40%"
                                       FontSize="11" Margin="0,0,0,14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text3Brush}"/>

                            <!-- 图表 -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,14"/>
                            <TextBlock Text="图表" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"
                                       Foreground="{DynamicResource Text2Brush}"/>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="横轴起始时间" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <ComboBox x:Name="StartHourCombo" Width="130" HorizontalAlignment="Right"
                                          SelectionChanged="OnStartHourChanged"/>
                            </Grid>
                            <TextBlock Text="时间轴与柱状图从哪个钟点开始画。默认 00:00（自然日）"
                                       FontSize="11" Margin="0,-4,0,12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text3Brush}"/>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="时间轴分格粒度" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <ComboBox x:Name="BucketCombo" Width="130" HorizontalAlignment="Right"
                                          SelectionChanged="OnBucketChanged">
                                    <ComboBoxItem Content="30 分钟一格" Tag="30"/>
                                    <ComboBoxItem Content="1 小时一格" Tag="60"/>
                                    <ComboBoxItem Content="3 小时一格" Tag="180"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="粒度越粗整体形态越清楚，悬停可以看到每格内各应用的时长明细"
                                       FontSize="11" Margin="0,-4,0,14" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text3Brush}"/>

                            <TextBlock Text="界面" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"
                                       Foreground="{DynamicResource Text2Brush}"/>

                            <CheckBox x:Name="AnimCheck" Content="启用界面动效"
                                      Margin="0,0,0,10" Click="OnAnimToggled"
                                      Foreground="{DynamicResource TextBrush}"/>
                            <CheckBox x:Name="OpenWindowCheck" Content="启动时打开主界面"
                                      Margin="0,0,0,10" Click="OnOpenWindowToggled"
                                      Foreground="{DynamicResource TextBrush}"/>
                            <CheckBox x:Name="CompareCheck" Content="排行显示与上一周期对比"
                                      Margin="0,0,0,10" Click="OnCompareToggled"
                                      Foreground="{DynamicResource TextBrush}"/>

                            <!-- 开机自启 -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,14"/>
                            <TextBlock Text="开机自启" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"
                                       Foreground="{DynamicResource Text2Brush}"/>

                            <CheckBox x:Name="AutoStartCheck" Content="登录后自动启动（静默，只在托盘）"
                                      Margin="0,0,0,6" Click="OnAutoStartToggled"
                                      Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="AutoStartHint" FontSize="11" Margin="0,0,0,4"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource Text3Brush}"/>

                            <!-- 关闭行为 -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,14"/>
                            <TextBlock Text="关闭窗口时" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"
                                       Foreground="{DynamicResource Text2Brush}"/>

                            <StackPanel x:Name="CloseActionPanel">
                                <RadioButton x:Name="CloseAskRadio" Content="每次询问" GroupName="CloseAction"
                                             Margin="0,0,0,8" Tag="0" Checked="OnCloseActionChanged"
                                             Foreground="{DynamicResource TextBrush}"/>
                                <RadioButton x:Name="CloseTrayRadio" Content="最小化到托盘，继续记录"
                                             GroupName="CloseAction" Margin="0,0,0,8" Tag="1"
                                             Checked="OnCloseActionChanged"
                                             Foreground="{DynamicResource TextBrush}"/>
                                <RadioButton x:Name="CloseExitRadio" Content="彻底退出程序"
                                             GroupName="CloseAction" Tag="2" Checked="OnCloseActionChanged"
                                             Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>

                            <Border x:Name="TrayWarnBox" CornerRadius="8" Padding="12,10" Margin="0,12,0,0"
                                    Background="{DynamicResource Surface3Brush}" Visibility="Collapsed">
                                <TextBlock x:Name="TrayWarnText" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text2Brush}"/>
                            </Border>

                            <!-- 数据 -->
                            <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,14"/>
                            <TextBlock Text="数据" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"
                                       Foreground="{DynamicResource Text2Brush}"/>

                            <TextBlock x:Name="DataDirText" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                                       Foreground="{DynamicResource Text3Brush}"/>

                            <StackPanel Orientation="Horizontal">
                                <Button Content="打开数据目录" Style="{StaticResource DialogButton}"
                                        Click="OnOpenDataFolder"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部 -->
                    <Grid Grid.Row="2" Margin="22,14,22,18">
                        <TextBlock x:Name="SettingsHint" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Text3Brush}"/>
                        <Button HorizontalAlignment="Right" Content="完成"
                                Style="{StaticResource DialogButton}" IsDefault="True"
                                Click="OnSettingsClose"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--
            ===== 应用分类面板 =====

            结构按用户要求：**统计在上、自定义在下**。
              1. 圆环图 + 图例（各分类时长占比）
              2. 新建分类（自己起名字）
              3. 应用列表（逐个改分类，带搜索）

            ZIndex 比设置面板再高一级，两个面板理论上不会同时开，
            但真同时开了也不该互相穿透。
        -->
        <Grid x:Name="CategoryOverlay" Grid.RowSpan="2" Panel.ZIndex="25"
              Visibility="Collapsed">
            <Rectangle Fill="#66000000" MouseLeftButtonDown="OnCategoryBackdropClick"/>

            <Border x:Name="CategoryCard"
                    Width="620" MaxHeight="720"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource DialogSurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="16" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.18"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 标题 -->
                        <RowDefinition Height="Auto"/>   <!-- 饼图 -->
                        <RowDefinition Height="Auto"/>   <!-- 新建分类 -->
                        <RowDefinition Height="*"/>      <!-- 应用列表 -->
                        <RowDefinition Height="Auto"/>   <!-- 底部按钮 -->
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <Grid Grid.Row="0" Margin="22,18,14,10">
                        <StackPanel Orientation="Horizontal">
                            <!-- 图标与顶栏的分类按钮同字形，保持一一对应 -->
                            <Border Width="28" Height="28" CornerRadius="8"
                                    Background="{DynamicResource Surface3Brush}">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="应用分类" FontSize="15.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="CategorySummaryText" FontSize="11.5"
                                           Foreground="{DynamicResource Text3Brush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!--
                            周期切换：口径与主界面一致（周从周一算、月是自然月）。
                            切这里下方列表也跟着切，两处显示同一个周期。
                        -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,34,0">
                            <Border Background="{DynamicResource Surface3Brush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="CatTabDay" Style="{StaticResource SegmentButton}"
                                                 Content="日" GroupName="CatRange" IsChecked="True"
                                                 Tag="Day" Checked="OnCategoryRangeChecked"/>
                                    <RadioButton x:Name="CatTabWeek" Style="{StaticResource SegmentButton}"
                                                 Content="周" GroupName="CatRange"
                                                 Tag="Week" Checked="OnCategoryRangeChecked"/>
                                    <RadioButton x:Name="CatTabMonth" Style="{StaticResource SegmentButton}"
                                                 Content="月" GroupName="CatRange"
                                                 Tag="Month" Checked="OnCategoryRangeChecked"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 关闭按钮：放在标题行右侧。周期切换靠左让出位置 -->
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                                Style="{StaticResource TextButton}" Content="&#xE711;"
                                FontFamily="Segoe MDL2 Assets" Click="OnCategoryClose"
                                ToolTip="关闭"/>
                    </Grid>

                    <!-- 统计：圆环图 + 图例 -->
                    <Border Grid.Row="1" Margin="22,0,22,12" Padding="16,14"
                            CornerRadius="12" Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 圆环 + 中间总时长 -->
                            <Grid Grid.Column="0" Width="150" Height="150">
                                <local:DonutChart x:Name="CategoryDonut"/>
                                <!--
                                    中心文字**固定用白色**，不跟主题走。
                                    原因：它压在圆环上，而环里的扇区在任何主题下都是
                                    中深色，用 TextBrush（浅色主题下是深灰）会看不清。
                                    加一层白描边保证在浅色扇区上也能读。
                                -->
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                            IsHitTestVisible="False">
                                    <TextBlock x:Name="CategoryTotalText" FontSize="16"
                                               FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="White">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0"
                                                              Opacity="0.55" Color="Black"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    <TextBlock x:Name="CategoryTotalCaption" Text="今日合计" FontSize="10.5" HorizontalAlignment="Center"
                                               Margin="0,2,0,0" Foreground="White" Opacity="0.85">
                                        <TextBlock.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0"
                                                              Opacity="0.55" Color="Black"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>

                            <!-- 图例：分类色块 + 时长 + 占比 -->
                            <ScrollViewer Grid.Column="1" Margin="16,0,0,0"
                                          VerticalScrollBarVisibility="Auto" MaxHeight="150">
                                <ItemsControl x:Name="CategoryLegendHost">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="10" Height="10"
                                                        CornerRadius="3" VerticalAlignment="Center"
                                                        Margin="0,0,8,0"
                                                        Background="{Binding Brush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextBrush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding TimeText}"
                                                           FontSize="12" Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Text2Brush}"/>
                                                <TextBlock Grid.Column="3" Text="{Binding PercentText}"
                                                           FontSize="12" Margin="10,0,0,0" MinWidth="48"
                                                           TextAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Text3Brush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- 新建 / 删除分类 -->
                    <Grid Grid.Row="2" Margin="22,0,22,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="新建分类" VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="NewCategoryBox" Grid.Column="1" Padding="8,5"
                                 VerticalContentAlignment="Center"
                                 ToolTip="填一个分类名，例如「学习」「剪辑」。最多 12 个字"
                                 KeyDown="OnNewCategoryKeyDown"/>
                        <Button Grid.Column="2" Content="添加" Style="{StaticResource TextButton}"
                                Margin="6,0,0,0" Click="OnAddCategoryClick"/>
                        <Button Grid.Column="3" Content="删除所选" Style="{StaticResource TextButton}"
                                Margin="2,0,0,0" Click="OnDeleteCategoryClick"
                                ToolTip="删除一个自定义分类（系统默认分类不能删）"/>
                    </Grid>

                    <!--
                        共享取色器。只造一个，按需放到被点的色点旁边。

                        为什么不做成"每行一个 Popup"：应用列表可能有上百行，
                        每行造一个 Popup（含 10 个色块 + 输入框）纯属浪费；
                        而且同一时刻只可能改一个颜色，共享完全够用。

                        StaysOpen=False 让点击外部自动关闭，符合弹出层的常规行为。
                    -->
                    <Popup x:Name="CategoryColorPopup" StaysOpen="False"
                           Placement="Bottom" AllowsTransparency="True"
                           PopupAnimation="Fade" Focusable="True">
                        <Border Margin="0,4,0,0" Padding="12,10" CornerRadius="10"
                                Background="{DynamicResource DialogSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.22"/>
                            </Border.Effect>

                            <StackPanel Width="248">
                                <TextBlock x:Name="ColorPopupTarget" FontSize="11.5" Margin="0,0,0,8"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <!-- 预设色 -->
                                <ItemsControl x:Name="CategoryColorOptionHost">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="24" Height="24" CornerRadius="6"
                                                    Margin="0,0,6,6" Cursor="Hand"
                                                    Background="{Binding Brush}"
                                                    ToolTip="{Binding Name}"
                                                    MouseLeftButtonUp="OnCategoryColorOptionClick"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 自定义色号 -->
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CategoryColorHexBox" Grid.Column="0" Padding="6,4"
                                             VerticalContentAlignment="Center"
                                             ToolTip="填十六进制色号，例如 #66CCFF"
                                             KeyDown="OnCategoryColorHexKeyDown"/>
                                    <Button Grid.Column="1" Content="应用" Margin="6,0,0,0"
                                            Style="{StaticResource TextButton}" Padding="8,3"
                                            Click="OnCategoryColorHexApply"/>
                                    <Button Grid.Column="2" Content="默认" Margin="2,0,0,0"
                                            Style="{StaticResource TextButton}" Padding="8,3"
                                            Click="OnCategoryColorResetClick"
                                            ToolTip="恢复该分类的默认颜色"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- 应用列表 -->
                    <Grid Grid.Row="3" Margin="22,0,22,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBox x:Name="CategorySearchBox" Padding="8,5"
                                     VerticalContentAlignment="Center"
                                     TextChanged="OnCategorySearchChanged"
                                     ToolTip="按名称或路径筛选"/>
                            <TextBlock x:Name="CategorySearchHint" Text="搜索应用…" FontSize="12"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Foreground="{DynamicResource Text3Brush}"/>
                        </Grid>

                        <!--
                            表头。
                            "色点改的是分类色"这句必须写明：删掉上方那行分类色块之后，
                            这里成了唯一的改色入口，而用户点的是**某一个应用**旁边的点，
                            很容易以为只改这一个应用。实际改的是它所属的分类，
                            同分类的所有应用与饼图里那一块都会跟着变。
                        -->
                        <Grid Grid.Row="1" Margin="0,0,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="应用" FontSize="11"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBlock Grid.Column="1" Text="时长" FontSize="11" MinWidth="58"
                                       TextAlignment="Right" Margin="0,0,14,0"
                                       Foreground="{DynamicResource Text3Brush}"/>
                            <TextBlock Grid.Column="2" FontSize="11" Width="136"
                                       Text="分类　（点色点改该分类的颜色）"
                                       Foreground="{DynamicResource Text3Brush}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                      Padding="0,0,4,0">
                            <ItemsControl x:Name="CategoryAppHost">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="22" Height="22"
                                                       VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Display}" FontSize="12.5"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <TextBlock Text="{Binding PathHint}" FontSize="10"
                                                               MaxWidth="230" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Text3Brush}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}"
                                                       FontSize="12" MinWidth="58" TextAlignment="Right"
                                                       Margin="0,0,14,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Text2Brush}"/>

                                            <Grid Grid.Column="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <ComboBox ItemsSource="{Binding DataContext.AllCategories,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              SelectedItem="{Binding Category, Mode=TwoWay}"
                                                              SelectionChanged="OnAppCategoryChanged"
                                                              FontSize="12"/>
                                                    <TextBlock Text="{Binding ManualHint}" FontSize="9.5"
                                                               Margin="2,2,0,0"
                                                               Foreground="{DynamicResource Text3Brush}"/>
                                                </StackPanel>

                                                <!--
                                                    色点：点它改**该应用所属分类**的颜色。

                                                    颜色是分类的属性、不是单个应用的属性，所以这里
                                                    改的是分类色（会同时影响饼图里那一块和所有
                                                    同分类的应用）。放在分类框旁边是因为
                                                    "我想让这个应用显示成别的颜色"是最自然的起点。
                                                -->
                                                <Border Grid.Column="1" Width="18" Height="18"
                                                        CornerRadius="5" Margin="6,0,0,0"
                                                        VerticalAlignment="Top" Cursor="Hand"
                                                        Background="{Binding CategoryBrush}"
                                                        ToolTip="改该分类的颜色"
                                                        MouseLeftButtonUp="OnAppColorDotClick"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- 底部 -->
                    <Grid Grid.Row="4" Margin="22,12,22,18">
                        <TextBlock x:Name="CategoryManualHint" VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource Text3Brush}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="全部重置" Style="{StaticResource TextButton}"
                                    Click="OnResetCategoriesClick"
                                    ToolTip="清空所有手动分类，全部改回关键字自动识别"/>
                            <Button Content="完成" Style="{StaticResource DialogButton}"
                                    Margin="8,0,0,0" IsDefault="True" Click="OnCategoryClose"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
