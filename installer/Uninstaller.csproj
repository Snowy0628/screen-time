<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>卸载</AssemblyName>
    <RootNamespace>ScreenTime.Uninstaller</RootNamespace>
    <StartupObject>Uninstaller</StartupObject>
    <InvariantGlobalization>false</InvariantGlobalization>
    <LangVersion>12</LangVersion>

    <!-- 与 Installer.csproj 分开的中间目录，避免两者抢占 singlefilehost.exe。
         必须放在项目目录之外，理由见 Installer.csproj 里的说明。 -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.obj\Uninstaller\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\.obj\Uninstaller-bin\</BaseOutputPath>

    <!-- 与主程序一致：自包含、单文件，无需装 .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>屏幕使用时间 卸载程序</AssemblyTitle>
    <Product>屏幕使用时间</Product>
  </PropertyGroup>

  <!-- 同上：排除同目录下的安装程序源码 -->
  <ItemGroup>
    <Compile Remove="Installer.cs" />
  </ItemGroup>

</Project>
