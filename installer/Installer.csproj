<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>安装</AssemblyName>
    <RootNamespace>ScreenTime.Installer</RootNamespace>
    <StartupObject>Installer</StartupObject>
    <InvariantGlobalization>false</InvariantGlobalization>
    <LangVersion>12</LangVersion>

    <!-- 中间目录/输出目录在 Directory.Build.props 里统一设置。
         那两个属性必须在 Microsoft.Common.props 导入之前赋值，
         写在 .csproj 里能工作但会触发 MSB3539 警告。 -->

    <!-- 与主程序一致：自包含、单文件，朋友那边无需装 .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>屏幕使用时间 安装程序</AssemblyTitle>
    <Product>屏幕使用时间</Product>
  </PropertyGroup>

  <!--
    安装与卸载两个程序放在同一目录，而 SDK 默认会把目录下所有 .cs 都编译进来，
    结果 Installer.csproj 里混进了 Uninstaller 的 Main（报"定义了多个入口点"）。
    必须显式排除对方的源文件。
  -->
  <ItemGroup>
    <Compile Remove="Uninstaller.cs" />
  </ItemGroup>

</Project>
