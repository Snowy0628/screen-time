<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>安装</AssemblyName>
    <RootNamespace>ScreenTime.Installer</RootNamespace>
    <StartupObject>Installer</StartupObject>
    <InvariantGlobalization>false</InvariantGlobalization>
    <LangVersion>12</LangVersion>

    <!--
      两个安装程序项目在同一目录 installer\ 下，必须各用各的中间目录，
      否则它们的 singlefilehost.exe 会互相抢占，
      表现为随机的 "请求的操作无法在使用用户映射区域打开的文件上执行"（文件被占用）。

      关键：中间目录必须放到**项目目录之外**。
      SDK 只会自动排除「项目目录下的 obj\」，一旦把 BaseIntermediateOutputPath
      指到别处（哪怕是 installer\obj\Installer\），生成的 AssemblyInfo.cs
      就会被当成源码再编译一遍，报一堆 "特性重复"（CS0579）。
      放到仓库根的 .obj\ 下既避开了默认排除逻辑，又天然不在源码树里。
    -->
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)..\.obj\Installer\</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)..\.obj\Installer-bin\</BaseOutputPath>

    <!-- 与主程序一致：自包含、单文件，朋友那边无需装 .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>

    <ApplicationIcon>..\assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>屏幕使用时间 安装程序</AssemblyTitle>
    <Product>屏幕使用时间</Product>
  </PropertyGroup>

  <!--
    安装与卸载两个程序放在同一目录，而 SDK 默认会把目录下所有 .cs 都编译进来，
    结果 Installer.csproj 里混进了 Uninstaller 的 Main（报"定义了多个入口点"）。
    必须显式排除对方的源文件。
  -->
  <ItemGroup>
    <Compile Remove="Uninstaller.cs" />
  </ItemGroup>

</Project>
